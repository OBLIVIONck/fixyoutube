{
  "name": "fixyoutube",
  "version": "0.1.0",
  "description": "Rich YouTube embeds for Discord, Telegram, and more - videos, Shorts, community posts, and polls",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx src/node.ts",
    "start": "tsx src/node.ts",
    "deploy": "wrangler deploy",
    "deploy:cf": "bash scripts/deploy-cloudflare.sh",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "youtube",
    "embed",
    "discord",
    "oembed",
    "cloudflare-workers"
  ],
  "author": "OBLIVIONck",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.11.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260228.0",
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0"
  }
}
